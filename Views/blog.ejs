<!DOCTYPE html>
<html>

    <head>

        <title>Blog</title>
        <meta charset="utf-8">
        <link href="LAB 9/style_blog.css" rel="stylesheet">
        

    </head>



    <body>
        <div id="container">
            <form action="/criar" method="get">
            <input type="submit" value="Criar Post">
            </form>
        </div>

        <% for (let i=0; i<itens.length; i++){ %>
            <div id="post">
                <p>Título: <%= itens[i].db_titulo %></p>
                <p>Resumo: <%= itens[i].db_resumo %></p>
                <p>Conteúdo: <%= itens[i].db_conteudo %></p>
            </div>
        <% } %>


    </body>






</html>